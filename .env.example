# Local API. Keep bound to loopback for a single-user workstation.
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_PATH=./data/studio.sqlite3

# Existing local installs; these paths are configurable and are not copied.
LTX_ROOT=~/AI-Video-Studio/src/ltx-2-mlx
HF_CACHE=~/AI-Video-Studio/models/ltx/huggingface
REMOTION_STUDIO=~/AI-Video-Studio/remotion-studio
REMOTION_RENDER_PORT=0
STORY_PROJECT=~/AI-Video-Studio/projects/scorpion-frog

# Configure the exact local runner script/entrypoint after confirming your install.
LTX_EXECUTABLE=~/AI-Video-Studio/src/ltx-2-mlx/.venv/bin/ltx-2-mlx
REMOTION_EXECUTABLE=~/AI-Video-Studio/remotion-studio/node_modules/.bin/remotion
FFPROBE_EXECUTABLE=ffprobe
OUTPUT_ROOT=~/AI-Video-Studio/outputs
ALLOWED_PATH_ROOTS=~/AI-Video-Studio

# Advisory preflight thresholds. Tune these for this workstation; they are warnings, not limits.
PREFLIGHT_MAX_SWAP_GB=24
PREFLIGHT_MIN_DISK_GB=10
PREFLIGHT_PRESSURE_FREE_PERCENT_MAX=15
PREFLIGHT_PRESSURE_CONSECUTIVE_SAMPLES=3
PREFLIGHT_PRESSURE_SAMPLE_INTERVAL_SECONDS=10
